# 强制源代码保持 UTF-8 + LF，防止 Windows 下被转成 GBK/CRLF 造成乱码
* text=auto eol=lf

# 明确声明文本文件的 UTF-8 编码
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 二进制文件不转换
*.png binary
*.jpg binary
*.ico binary
*.apk binary
*.exe binary
*.dmg binary
*.AppImage binary
