{
  "expo": {
    "name": "SynData",
    "slug": "syndate-android",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.syndate.android"
    },
    "android": {
      "package": "com.syndate.android",
      "adaptiveIcon": {
        "backgroundColor": "#4a90d9"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    }
  }
}
