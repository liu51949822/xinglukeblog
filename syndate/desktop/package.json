{
  "name": "syndate-desktop",
  "version": "1.0.0",
  "description": "SynData 桌面端 - 剪贴板同步 + 文件传输",
  "author": "liu51949822",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/liu51949822/xinglukeblog.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.syndate.desktop",
    "productName": "SynData",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "syndate-${version}-win.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "syndate-${version}-mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "syndate-${version}-linux.${ext}",
      "category": "Utility"
    }
  }
}
